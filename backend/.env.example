# Backend Environment Variables (Render)

# Node Environment
NODE_ENV=production

# Server Port (Render sets this automatically; defaults to 5005 locally)
PORT=5005

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sports_court_booking?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sports_court_booking?retryWrites=true&w=majority

# JWT Secret Key for Authentication (REQUIRED - server refuses to boot without it)
JWT_SECRET=your_super_secret_production_jwt_key_here

# Phone verification. Keep false until the venue's business SMS/WhatsApp sender is live.
# false -> OTP step is skipped entirely (bookings stored with isPhoneVerified: false)
# true  -> a real code is sent and unverified bookings are rejected
OTP_ENFORCED=false

# Frontend Production URL (for CORS protection)
# Supports comma-separated list of allowed origins (e.g., https://your-app.vercel.app,https://your-custom-domain.com)
FRONTEND_URL=https://your-frontend-app.vercel.app
