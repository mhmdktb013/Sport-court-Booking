# ==========================================
# SportsZone Production Deployment Reference
# ==========================================

# ------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables
VITE_API_URL=https://your-backend-api.onrender.com

# ------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render)
# ------------------------------------------
# Set these in Render Web Service -> Environment Variables
NODE_ENV=production
PORT=5005
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sports_court_booking?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_production_jwt_key_here
FRONTEND_URL=https://your-frontend-app.vercel.app
